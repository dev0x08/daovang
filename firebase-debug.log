[debug] [2026-07-25T02:16:02.098Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/banthuyen-3b996/rulesets {"name":"projects/banthuyen-3b996/rulesets/826568eb-e733-4ed1-b8ca-9e665939991f","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() { return request.auth != null; }\r\n    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }\r\n    function roomMember(data) { return signedIn() && data.players is list && data.players.size() > 0 && data.players.hasAny([{'uid': request.auth.uid}]); }\r\n    function validRoomShape(data) {\r\n      return data.code is string && data.code.size() == 6\r\n        && data.name is string && data.name.size() >= 3 && data.name.size() <= 40\r\n        && data.hostId is string\r\n        && data.status in ['waiting','started']\r\n        && data.visibility in ['public','private']\n        && (!data.keys().hasAny(['mapSkin']) || data.mapSkin in ['board-default','board-volcano','board-ice','board-shipwreck'])\n        && data.maxPlayers is int && data.maxPlayers >= 6 && data.maxPlayers <= 8\r\n        && data.players is list && data.players.size() >= 1 && data.players.size() <= data.maxPlayers;\r\n    }\r\n\r\n    match /users/{uid} {\r\n      allow read: if signedIn();\r\n      allow create: if isSelf(uid)\r\n        && request.resource.data.uid == uid\r\n        && request.resource.data.coins == 500\r\n        && request.resource.data.exp == 0\r\n        && request.resource.data.rankPoints == 0\n        && request.resource.data.wins == 0\r\n        && request.resource.data.losses == 0\r\n        && request.resource.data.gamesPlayed == 0;\r\n      // This blocks edits to identity ownership and rejects impossible/negative values.\r\n      // Economy is still client-driven in this prototype; production rewards should move to Cloud Functions.\r\n      allow update: if isSelf(uid)\r\n        && request.resource.data.uid == resource.data.uid\r\n        && request.resource.data.email == resource.data.email\r\n        && request.resource.data.coins is int && request.resource.data.coins >= 0 && request.resource.data.coins <= 1000000\r\n        && request.resource.data.exp is int && request.resource.data.exp >= 0 && request.resource.data.exp <= 10000000\r\n        && (!request.resource.data.keys().hasAny(['rankPoints'])\r\n          || (request.resource.data.rankPoints is int && request.resource.data.rankPoints >= 0 && request.resource.data.rankPoints <= 10000))\r\n        && request.resource.data.wins is int && request.resource.data.wins >= 0\r\n        && request.resource.data.losses is int && request.resource.data.losses >= 0\r\n        && request.resource.data.gamesPlayed == request.resource.data.wins + request.resource.data.losses\r\n        && request.resource.data.onlineSecondsToday is int && request.resource.data.onlineSecondsToday >= 0 && request.resource.data.onlineSecondsToday <= 86400\r\n        && request.resource.data.dailyChats is int && request.resource.data.dailyChats >= 0 && request.resource.data.dailyChats <= 500;\r\n      allow delete: if false;\n      match /friendRequests/{fromUid} {\n        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == fromUid);\n        allow create: if signedIn()\n          && request.auth.uid == fromUid\n          && fromUid != uid\n          && request.resource.data.fromUid == fromUid\n          && request.resource.data.toUid == uid\n          && request.resource.data.uid == fromUid\n          && request.resource.data.displayName is string\n          && request.resource.data.displayName.size() <= 60\n          && request.resource.data.photoURL is string\n          && request.resource.data.photoURL.size() <= 500\n          && request.resource.data.rank is string\n          && request.resource.data.equipped is map\n          && request.resource.data.createdAt == request.time;\n        allow update: if false;\n        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == fromUid);\n      }\n      match /friends/{friendUid} {\n        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);\n        allow create: if signedIn()\n          && request.resource.data.friendUid == friendUid\n          && request.resource.data.uid == friendUid\n          && request.resource.data.displayName is string\n          && request.resource.data.displayName.size() <= 60\n          && request.resource.data.photoURL is string\n          && request.resource.data.photoURL.size() <= 500\n          && request.resource.data.rank is string\n          && request.resource.data.equipped is map\n          && request.resource.data.createdAt == request.time\n          && (\n            (request.auth.uid == uid\n              && exists(/databases/$(database)/documents/users/$(uid)/friendRequests/$(friendUid)))\n            || (request.auth.uid == friendUid\n              && exists(/databases/$(database)/documents/users/$(friendUid)/friendRequests/$(uid)))\n          );\n        allow update: if signedIn() && request.auth.uid == uid;\n        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);\n      }\n      match /roomInvites/{roomId} {\n        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == resource.data.fromUid);\n        allow create, update: if signedIn()\n          && request.auth.uid == request.resource.data.fromUid\n          && request.resource.data.roomId == roomId\n          && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))\n          && request.resource.data.roomCode is string\n          && request.resource.data.roomName is string\n          && request.resource.data.fromName is string\n          && request.resource.data.fromPhotoURL is string\n          && request.resource.data.createdAt == request.time;\n        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == resource.data.fromUid);\n      }\n      match /matchHistory/{matchId} { allow read: if isSelf(uid); allow create: if isSelf(uid) && request.resource.data.matchId == matchId; allow update, delete: if false; }\n      match /completedMatches/{matchId} {\r\n        allow read: if isSelf(uid);\r\n        allow create: if isSelf(uid)\r\n          && !exists(/databases/$(database)/documents/users/$(uid)/completedMatches/$(matchId))\r\n          && request.resource.data.won is bool\r\n          && request.resource.data.reward.exp is int\r\n          && request.resource.data.reward.coins is int\r\n          && request.resource.data.reward.exp >= 0 && request.resource.data.reward.exp <= 500\r\n          && request.resource.data.reward.coins >= 0 && request.resource.data.reward.coins <= 500;\r\n        allow update, delete: if false;\r\n      }\r\n    }\r\n\r\n    match /reports/{reportId} { allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid && request.resource.data.reason in ['AFK','Spam','Tên phản cảm','Phá game','Nghi gian lận']; allow read, update, delete: if false; }\r\n\r\n    match /matches/{matchId} {\n      allow create: if signedIn()\n        && request.resource.data.roomId == matchId\n        && request.resource.data.participantIds is list\n        && request.auth.uid in request.resource.data.participantIds;\n      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;\n      allow update: if signedIn()\n        && request.auth.uid in resource.data.participantIds\n        && request.resource.data.roomId == resource.data.roomId\n        && request.resource.data.participantIds == resource.data.participantIds;\n      allow delete: if false;\n    }\n\n    match /rooms/{roomId} {\n      allow read: if signedIn();\r\n      allow create: if signedIn() && validRoomShape(request.resource.data)\n        && request.resource.data.hostId == request.auth.uid\n        && (\n          (request.resource.data.mode == 'online' && request.resource.data.players.size() == 1)\n          || (request.resource.data.mode == 'ai'\n              && request.resource.data.players.size() == 6\n              && request.resource.data.players[1].bot == true\n              && request.resource.data.players[2].bot == true\n              && request.resource.data.players[3].bot == true\n              && request.resource.data.players[4].bot == true\n              && request.resource.data.players[5].bot == true)\n        )\n        && request.resource.data.players[0].uid == request.auth.uid;\n      allow update: if signedIn() && validRoomShape(request.resource.data)\r\n        && request.resource.data.hostId == resource.data.hostId\r\n        && request.resource.data.code == resource.data.code\r\n        && (\r\n          request.auth.uid == resource.data.hostId\r\n          || (resource.data.status == 'waiting' && request.resource.data.status == 'waiting'\r\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players']))\r\n        );\r\n      allow delete: if signedIn() && request.auth.uid == resource.data.hostId;\r\n\r\n      match /messages/{messageId} {\r\n        allow read: if signedIn();\r\n        allow create: if signedIn()\r\n          && request.resource.data.keys().hasOnly(['uid','displayName','photoURL','equipped','text','createdAt'])\n          && request.resource.data.uid == request.auth.uid\r\n          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60\r\n          && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500\n          && request.resource.data.equipped is map\n          && request.resource.data.text is string\r\n          && request.resource.data.text.size() > 0\r\n          && request.resource.data.text.size() <= 300\r\n          && request.resource.data.createdAt == request.time;\r\n        allow update, delete: if false;\r\n      }\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-07-25T02:16:01.825471Z","metadata":{"services":["cloud.firestore"]}}
