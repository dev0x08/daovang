  && request.resource.data.exp == 0\r\n        && request.resource.data.rankPoints == 0\n        && request.resource.data.wins == 0\r\n        && request.resource.data.losses == 0\r\n        && request.resource.data.gamesPlayed == 0;\r\n      // This blocks edits to identity ownership and rejects impossible/negative values.\r\n      // Economy is still client-driven in this prototype; production rewards should move to Cloud Functions.\r\n      allow update: if isAdmin() || (isSelf(uid)\n        && request.resource.data.uid == resource.data.uid\n        && request.resource.data.email == resource.data.email\r\n        && request.resource.data.coins is int && request.resource.data.coins >= 0 && request.resource.data.coins <= 1000000\r\n        && request.resource.data.exp is int && request.resource.data.exp >= 0 && request.resource.data.exp <= 10000000\r\n        && (!request.resource.data.keys().hasAny(['rankPoints'])\r\n          || (request.resource.data.rankPoints is int && request.resource.data.rankPoints >= 0 && request.resource.data.rankPoints <= 10000))\r\n        && request.resource.data.wins is int && request.resource.data.wins >= 0\r\n        && request.resource.data.losses is int && request.resource.data.losses >= 0\r\n        && request.resource.data.gamesPlayed == request.resource.data.wins + request.resource.data.losses\r\n        && request.resource.data.onlineSecondsToday is int && request.resource.data.onlineSecondsToday >= 0 && request.resource.data.onlineSecondsToday <= 86400\r\n        && request.resource.data.dailyChats is int && request.resource.data.dailyChats >= 0 && request.resource.data.dailyChats <= 500);\n      allow delete: if isAdmin() && uid != request.auth.uid;\n      match /friendRequests/{fromUid} {\n        allow read: if isAdmin() || (signedIn() && (request.auth.uid == uid || request.auth.uid == fromUid));\n        allow create: if signedIn()\n          && request.auth.uid == fromUid\n          && fromUid != uid\n          && request.resource.data.fromUid == fromUid\n          && request.resource.data.toUid == uid\n          && request.resource.data.uid == fromUid\n          && request.resource.data.displayName is string\n          && request.resource.data.displayName.size() <= 60\n          && request.resource.data.photoURL is string\n          && request.resource.data.photoURL.size() <= 500\n          && request.resource.data.rank is string\n          && request.resource.data.equipped is map\n          && request.resource.data.createdAt == request.time;\n        allow update: if false;\n        allow delete: if isAdmin() || (signedIn() && (request.auth.uid == uid || request.auth.uid == fromUid));\n      }\n      match /friends/{friendUid} {\n        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);\n        allow create: if signedIn()\n          && request.resource.data.friendUid == friendUid\n          && request.resource.data.uid == friendUid\n          && request.resource.data.displayName is string\n          && request.resource.data.displayName.size() <= 60\n          && request.resource.data.photoURL is string\n          && request.resource.data.photoURL.size() <= 500\n          && request.resource.data.rank is string\n          && request.resource.data.equipped is map\n          && request.resource.data.createdAt == request.time\n          && (\n            (request.auth.uid == uid\n              && exists(/databases/$(database)/documents/users/$(uid)/friendRequests/$(friendUid)))\n            || (request.auth.uid == friendUid\n              && exists(/databases/$(database)/documents/users/$(friendUid)/friendRequests/$(uid)))\n          );\n        allow update: if signedIn() && request.auth.uid == uid;\n        allow delete: if isAdmin() || (signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid));\n      }\n      match /roomInvites/{roomId} {\n        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == resource.data.fromUid);\n        allow create, update: if signedIn()\n          && request.auth.uid == request.resource.data.fromUid\n          && request.resource.data.roomId == roomId\n          && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))\n          && request.resource.data.roomCode is string\n          && request.resource.data.roomName is string\n          && request.resource.data.fromName is string\n          && request.resource.data.fromPhotoURL is string\n          && request.resource.data.createdAt == request.time;\n        allow delete: if isAdmin() || (signedIn() && (request.auth.uid == uid || request.auth.uid == resource.data.fromUid));\n      }\n      match /matchHistory/{matchId} { allow read: if isSelf(uid) || isAdmin(); allow create: if isSelf(uid) && request.resource.data.matchId == matchId; allow update: if false; allow delete: if isAdmin(); }\n      match /completedMatches/{matchId} {\r\n        allow read: if isSelf(uid) || isAdmin();\n        allow create: if isSelf(uid)\r\n          && !exists(/databases/$(database)/documents/users/$(uid)/completedMatches/$(matchId))\r\n          && request.resource.data.won is bool\r\n          && request.resource.data.reward.exp is int\r\n          && request.resource.data.reward.coins is int\r\n          && request.resource.data.reward.exp >= 0 && request.resource.data.reward.exp <= 500\r\n          && request.resource.data.reward.coins >= 0 && request.resource.data.reward.coins <= 500;\r\n        allow update: if false;\n        allow delete: if isAdmin();\n      }\n    }\n\n    match /bannedUsers/{uid} {\n      allow read: if isAdmin() || isSelf(uid);\n      allow create, update, delete: if isAdmin() && uid != request.auth.uid;\n    }\n\n    match /guildNames/{slug} {\n      allow read: if signedIn();\n      allow create: if isAdmin() || (signedIn()\n        && request.resource.data.guildId == slug\n        && request.resource.data.ownerId == request.auth.uid\n        && getAfter(/databases/$(database)/documents/guilds/$(slug)).data.ownerId == request.auth.uid);\n      allow update: if isAdmin();\n      allow delete: if isAdmin()\n        || (signedIn() && get(/databases/$(database)/documents/guilds/$(resource.data.guildId)).data.ownerId == request.auth.uid);\n    }\n\r\n    match /reports/{reportId} { allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid && request.resource.data.reason in ['AFK','Spam','Tên phản cảm','Phá game','Nghi gian lận']; allow read, update, delete: if false; }\r\n\r\n    match /likes/{likeId} {\n      allow read: if signedIn();\n      allow create: if isAdmin() || (signedIn()\n        && request.resource.data.keys().hasOnly(['giverId','receiverId','matchId','createdAt'])\n        && request.resource.data.giverId == request.auth.uid\n        && request.resource.data.receiverId is string\n        && request.resource.data.receiverId != request.auth.uid\n        && request.resource.data.matchId is string\n        && request.resource.data.createdAt == request.time\n        && likeId == request.resource.data.matchId + '_' + request.auth.uid\n        && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId))\n        && request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.participantIds\n        && request.resource.data.receiverId in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.participantIds);\n      allow update, delete: if false;\n    }\n\n    match /guilds/{guildId} {\n      function guildMember(uid) {\n        return get(/databases/$(database)/documents/guilds/$(guildId)/members/$(uid));\n      }\n      function hasGuildRole(roles) {\n        return signedIn()\n          && exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid))\n          && guildMember(request.auth.uid).data.role in roles;\n      }\n      allow read: if signedIn();\n      allow create: if signedIn()\n        && request.resource.data.ownerId == request.auth.uid\n        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 12\n        && request.resource.data.tag is string\n        && (request.resource.data.tag.size() == 0 || (request.resource.data.tag.size() >= 2 && request.resource.data.tag.size() <= 5))\n        && request.resource.data.memberCount == 1\n        && request.resource.data.totalContribution == 5000\n        && request.resource.data.totalWarPoints == 0\n        && request.resource.data.power == 0\n        && request.resource.data.treasury == 5000\n        && request.resource.data.guildLevel == 1\n        && request.resource.data.guildExp == 0\n        && request.resource.data.lifetimeGuildExp == 0\n        && request.resource.data.slug == guildId\n        && getAfter(/databases/$(database)/documents/guildNames/$(guildId)).data.guildId == guildId\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.exp >= 700\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coins >= 5000\n        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.coins\n          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coins - 5000;\n      allow update: if isAdmin() || hasGuildRole(['owner'])\n        || (hasGuildRole(['officer'])\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['announcement','updatedAt'])\n          && request.resource.data.announcement is string\n          && request.resource.data.announcement.size() <= 240)\n        || (hasGuildRole(['officer'])\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','updatedAt']))\n        || (hasGuildRole(['member','officer'])\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','updatedAt'])\n          && request.resource.data.memberCount == resource.data.memberCount - 1)\n        || (hasGuildRole(['member','officer'])\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['treasury','totalContribution','totalWarPoints','power','guildLevel','guildExp','lifetimeGuildExp','updatedAt'])\n          && request.resource.data.treasury >= resource.data.treasury\n          && request.resource.data.totalContribution >= resource.data.totalContribution\n          && request.resource.data.totalWarPoints >= resource.data.totalWarPoints\n          && request.resource.data.power >= resource.data.power\n          && (!resource.data.keys().hasAll(['guildLevel']) || request.resource.data.guildLevel >= resource.data.guildLevel)\n          && request.resource.data.guildLevel <= 5\n          && request.resource.data.guildExp >= 0\n          && (!resource.data.keys().hasAll(['lifetimeGuildExp'])\n            || (request.resource.data.lifetimeGuildExp >= resource.data.lifetimeGuildExp\n              && request.resource.data.lifetimeGuildExp <= resource.data.lifetimeGuildExp + 100)));\n      allow delete: if isAdmin() || hasGuildRole(['owner']);\n\n      match /members/{uid} {\n        allow read: if signedIn();\n        allow create: if isAdmin() || (signedIn()\n          && request.resource.data.uid == uid\n          && (\n            (request.auth.uid == uid\n              && request.resource.data.role == 'owner'\n              && getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.ownerId == uid)\n            || (hasGuildRole(['owner','officer']) && request.resource.data.role == 'member')\n          ));\n        allow update: if isAdmin() || (signedIn() && (\n          hasGuildRole(['owner'])\n          || (request.auth.uid == uid\n            && request.resource.data.uid == resource.data.uid\n            && request.resource.data.role == resource.data.role\n            && request.resource.data.title == resource.data.title\n            && request.resource.data.contribution >= resource.data.contribution\n            && request.resource.data.get('goldContribution', 0) >= resource.data.get('goldContribution', 0)\n            && request.resource.data.warPoints >= resource.data.warPoints)\n        ));\n        allow delete: if isAdmin() || (signedIn() && (\n          (resource.data.role != 'owner' && (hasGuildRole(['owner']) || request.auth.uid == uid))\n          || (resource.data.role == 'owner'\n            && request.auth.uid == uid\n            && !existsAfter(/databases/$(database)/documents/guilds/$(guildId)))\n        ));\n      }\n\n      match /applications/{uid} {\n        allow read: if isAdmin() || (signedIn() && (request.auth.uid == uid || hasGuildRole(['owner','officer'])));\n        allow create: if signedIn()\n          && request.auth.uid == uid\n          && request.resource.data.uid == uid\n          && request.resource.data.displayName is string\n          && request.resource.data.message is string\n          && request.resource.data.message.size() <= 120;\n        allow update: if false;\n        allow delete: if isAdmin() || (signedIn() && (request.auth.uid == uid || hasGuildRole(['owner','officer'])));\n      }\n\n      match /activities/{activityId} {\n        allow read: if signedIn();\n        allow create: if signedIn()\n          && exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid))\n          && request.resource.data.keys().hasOnly(['type','text','authorId','authorName','createdAt'])\n          && request.resource.data.type in ['guild','system']\n          && request.resource.data.text is string\n          && request.resource.data.text.size() > 0\n          && request.resource.data.text.size() <= 240\n          && request.resource.data.authorId == request.auth.uid\n          && request.resource.data.authorName is string\n          && request.resource.data.createdAt == request.time;\n        allow update: if false;\n        allow delete: if isAdmin() || hasGuildRole(['owner','officer']);\n      }\n\n      match /contributionEvents/{eventId} {\n        allow read: if signedIn();\n        allow create: if signedIn()\n          && request.resource.data.uid == request.auth.uid\n          && request.resource.data.metric in ['login','games','wins','thanks','gold']\n          && request.resource.data.points is int\n          && request.resource.data.points >= 0\n          && request.resource.data.points <= 100\n          && request.resource.data.amount is int\n          && request.resource.data.amount >= 0\n          && request.resource.data.createdAt == request.time;\n        allow update, delete: if false;\n      }\n\n      match /payouts/{uid} {\n        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid) || hasGuildRole(['owner']);\n        allow create, update: if hasGuildRole(['owner'])\n          && request.resource.data.uid == uid\n          && request.resource.data.amount is int\n          && request.resource.data.amount > 0\n          && request.resource.data.createdAt == request.time;\n        allow delete: if isAdmin() || hasGuildRole(['owner'])\n          || (signedIn()\n            && request.auth.uid == uid\n            && getAfter(/databases/$(database)/documents/users/$(uid)).data.coins\n              > get(/databases/$(database)/documents/users/$(uid)).data.coins\n            && getAfter(/databases/$(database)/documents/users/$(uid)).data.coins\n              <= get(/databases/$(database)/documents/users/$(uid)).data.coins + resource.data.amount);\n      }\n    }\n\n    match /matches/{matchId} {\n      allow create: if signedIn()\n        && request.resource.data.roomId == matchId\n        && request.resource.data.participantIds is list\n        && request.auth.uid in request.resource.data.participantIds;\n      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;\n      allow update: if signedIn()\n        && request.auth.uid in resource.data.participantIds\n        && request.resource.data.roomId == resource.data.roomId\n        && request.resource.data.participantIds == resource.data.participantIds;\n      allow delete: if false;\n    }\n\n    match /rooms/{roomId} {\n      allow read: if signedIn();\r\n      allow create: if signedIn() && validRoomShape(request.resource.data)\n        && request.resource.data.hostId == request.auth.uid\n        && (\n          (request.resource.data.mode == 'online' && request.resource.data.players.size() == 1)\n          || (request.resource.data.mode == 'ai'\n              && request.resource.data.players.size() == 6\n              && request.resource.data.players[1].bot == true\n              && request.resource.data.players[2].bot == true\n              && request.resource.data.players[3].bot == true\n              && request.resource.data.players[4].bot == true\n              && request.resource.data.players[5].bot == true)\n        )\n        && request.resource.data.players[0].uid == request.auth.uid;\n      allow update: if signedIn() && validRoomShape(request.resource.data)\r\n        && request.resource.data.hostId == resource.data.hostId\r\n        && request.resource.data.code == resource.data.code\r\n        && (\r\n          request.auth.uid == resource.data.hostId\r\n          || (resource.data.status == 'waiting' && request.resource.data.status == 'waiting'\r\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players']))\r\n        );\r\n      allow delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.hostId);\n\r\n      match /messages/{messageId} {\r\n        allow read: if signedIn();\r\n        allow create: if signedIn()\r\n          && request.resource.data.keys().hasOnly(['uid','displayName','photoURL','equipped','text','createdAt'])\n          && request.resource.data.uid == request.auth.uid\r\n          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60\r\n          && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500\n          && request.resource.data.equipped is map\n          && request.resource.data.text is string\r\n          && request.resource.data.text.size() > 0\r\n          && request.resource.data.text.size() <= 300\r\n          && request.resource.data.createdAt == request.time;\r\n        allow update: if false;\n        allow delete: if isAdmin();\n      }\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-08-02T02:21:13.132895Z","metadata":{"services":["cloud.firestore"]}}
